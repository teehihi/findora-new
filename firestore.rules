rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ===== USERS =====
    match /users/{userId} {
      // Ai cũng có thể đọc profile user (để hiển thị tên, avatar)
      allow read: if true;
      
      // Chỉ user mới tạo được profile của mình
      allow create: if isOwner(userId);
      
      // User có thể update profile của mình
      // HOẶC app có thể update points/totalReturned/averageRating/totalRatings khi verify OTP
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'points', 
          'totalReturned', 
          'totalReceived',
          'averageRating', 
          'totalRatings',
          'level'
        ])
      );
      
      // User có thể xóa profile của mình
      allow delete: if isOwner(userId);
    }
    
    // ===== POSTS =====
    match /posts/{postId} {
      // Ai cũng có thể đọc bài đăng (kể cả chưa đăng nhập)
      allow read: if true;
      
      // User đã đăng nhập có thể tạo bài
      allow create: if isAuthenticated();
      
      // Owner có thể update bài của mình
      // HOẶC app có thể update status/resolvedAt/resolvedBy/rating/review khi giải quyết
      allow update: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 
          'resolvedAt', 
          'resolvedBy', 
          'rating', 
          'review',
          'views',
          'likes'
        ])
      );
      
      // Owner có thể xóa bài của mình
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
      
      // COMMENTS (sub-collection)
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
      }
      
      // REPORTS (sub-collection)
      match /reports/{reportId} {
        allow create: if isAuthenticated();
        allow read: if isAuthenticated();
        allow update, delete: if false;
      }
    }
    
    // ===== CHATS =====
    match /chats/{chatId} {
      // User có thể đọc/ghi chat nếu là participant
      allow read, write: if isAuthenticated() && 
        (resource == null || request.auth.uid in resource.data.participants);
      
      // Cho phép tạo chat mới
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants;
      
      // MESSAGES (sub-collection)
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // ===== CALLS (CALL HISTORY & VOICE SIGNALING) =====
    // SIMPLE SIGNALING - Like Firebase WebRTC Reference Implementation
    // Structure: callEvents/{userId}/latestEvent/current
    match /callEvents/{userId}/{document=**} {
      // Any authenticated user can read/write
      // Caller writes to receiver's latestEvent, receiver writes to caller's
      allow read, write: if isAuthenticated();
    }
    
    match /calls/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /call_history/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /callLogs/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    // ===== NOTIFICATIONS =====
    match /notifications/{notificationId} {
      // User chỉ đọc được notification của mình
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      
      // App có thể tạo notification cho bất kỳ user nào
      allow create: if isAuthenticated();
      
      // User có thể update notification của mình (đánh dấu đã đọc)
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      
      // User có thể xóa notification của mình
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // ===== OTP CODES =====
    match /otpCodes/{otpId} {
      // User A (người mất đồ) tạo OTP
      allow create: if isAuthenticated() && 
        request.resource.data.lostUserId == request.auth.uid;
      
      // User A có thể xóa OTP của mình
      allow delete: if isAuthenticated() && 
        resource.data.lostUserId == request.auth.uid;
      
      // User B (người trả đồ) có thể đọc OTP để verify
      allow read: if isAuthenticated();
      
      // User B có thể verify OTP (update verified = true)
      allow update: if isAuthenticated() && 
        request.resource.data.verified == true &&
        resource.data.verified == false;
    }
    
    // ===== TRANSACTIONS =====
    match /transactions/{transactionId} {
      // App có thể tạo transaction khi verify OTP hoặc đổi voucher
      allow create: if isAuthenticated();
      
      // User chỉ đọc được transaction của mình
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Không cho phép update hoặc delete transaction
      allow update, delete: if false;
    }
    
    // ===== USER VOUCHERS =====
    match /user_vouchers/{voucherId} {
      // User tạo voucher khi đổi điểm
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // User chỉ đọc được voucher của mình
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // User có thể update voucher của mình (đánh dấu đã dùng)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Không cho phép xóa voucher
      allow delete: if false;
    }
    
    // ===== VOUCHERS (Catalog) =====
    match /vouchers/{voucherId} {
      // Ai cũng có thể đọc danh sách voucher
      allow read: if true;
      
      // Chỉ admin mới được tạo/sửa/xóa voucher
      allow write: if false;
    }
    
    // ===== REPORTS (Global) =====
    match /reports/{reportId} {
      // User có thể tạo report
      allow create: if isAuthenticated();
      
      // User có thể đọc report của mình
      allow read: if isAuthenticated();
      
      // Không cho phép update hoặc delete report
      allow update, delete: if false;
    }
    
    // ===== FCM TOKENS =====
    match /fcm_tokens/{tokenId} {
      // User có thể đọc/ghi FCM token của mình
      allow read, write: if isAuthenticated();
    }
    
    // ===== LEADERBOARD (nếu có collection riêng) =====
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false; // Chỉ server mới update
    }
    
    // ===== SETTINGS (nếu có) =====
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false; // Chỉ admin
    }
  }
}
